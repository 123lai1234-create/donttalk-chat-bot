# LLM config — Platform key (devcto.com / fe8.cn)
OPENAI_API_KEY=sk-cp-replace-with-valid-key
OPENAI_BASE_URL=https://api.fe8.cn/v1
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Site config
SITE_URL=https://donttalk.vercel.app
SITE_NAME=donttalk

# Server
HOST=0.0.0.0
PORT=8000

# CORS — list every origin that should be able to call /chat and /healthz.
# Both `donttalk.vercel.app` (legacy alias) and `dontalk.vercel.app` (current
# production) point at the same Vercel deployment, so we allow both.
ALLOWED_ORIGINS=https://donttalk.vercel.app,https://dontalk.vercel.app,http://localhost:4321,http://localhost:8000

# Vector DB
CHROMA_DIR=./data/chroma

# Logging
LOG_LEVEL=INFO
